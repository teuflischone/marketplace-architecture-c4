flowchart LR
    buyer["Покупатель<br/>Person"]
    seller["Продавец<br/>Person"]
    paymentProvider["Платёжный провайдер<br/>External System"]
    messageProvider["Email / SMS провайдер<br/>External System"]

    subgraph marketplace["Marketplace — Software System"]
        web["Web-приложение<br/>Browser SPA<br/>Интерфейс"]
        gateway["API Gateway<br/>HTTP API<br/>Точка входа"]
        users["User Service<br/>REST API<br/>Пользователи"]
        catalog["Catalog Service<br/>REST API<br/>Товары"]
        feed["Feed Service<br/>REST API<br/>Лента"]
        orders["Order Service<br/>REST API<br/>Заказы"]
        payments["Payment Service<br/>REST API<br/>Платежи"]
        notifications["Notification Service<br/>Event Consumer<br/>Уведомления"]
        broker["Message Broker<br/>Kafka / RabbitMQ<br/>События"]
        usersDb[("Users DB<br/>PostgreSQL")]
        catalogDb[("Catalog DB<br/>PostgreSQL")]
        feedDb[("Feed DB<br/>Redis")]
        ordersDb[("Orders DB<br/>PostgreSQL")]
        paymentsDb[("Payments DB<br/>PostgreSQL")]
    end

    buyer -->|HTTPS| web
    seller -->|HTTPS| web
    web -->|JSON / HTTPS| gateway
    gateway -->|sync REST| users
    gateway -->|sync REST| catalog
    gateway -->|sync REST| feed
    gateway -->|sync REST| orders
    feed -->|sync REST| catalog
    feed -->|sync REST| users
    orders -->|sync REST| catalog
    orders -->|sync REST| payments
    payments -->|HTTPS API| paymentProvider
    orders -->|async events| broker
    payments -->|async events| broker
    broker -->|async events| notifications
    notifications -->|HTTPS API| messageProvider
    users --> usersDb
    catalog --> catalogDb
    feed --> feedDb
    orders --> ordersDb
    payments --> paymentsDb
